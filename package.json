{
  "name": "calder",
  "version": "0.0.0",
  "private": true,
  "description": "Cal&der monorepo. See Architecture.md \u00a73.1 for the packages/apps split.",
  "workspaces": [
    "src/packages/*",
    "src/apps/*"
  ],
  "scripts": {
    "build:core": "npm run build --workspace @calder/core",
    "mobile": "npm run start --workspace @calder/mobile",
    "reseed": "npm run reseed --workspace @calder/mobile",
    "start": "npm run start --workspace @calder/mobile",
    "test:core": "npm test --workspace @calder/core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "check:db": "node tools/check-transactions.mjs",
    "verify": "npm run build:core && npm run test:core && npm run check:db && npm run check:sql && npm run check:chars && npm run check:routes && npm run check:hooks && npm run typecheck",
    "check:sql": "node tools/check-sql.mjs",
    "check:chars": "node tools/check-chars.mjs",
    "check:routes": "node tools/check-routes.mjs",
    "check:hooks": "eslint \"src/apps/mobile/**/*.{ts,tsx}\""
  },
  "devDependencies": {
    "@typescript-eslint/parser": "^8.69.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1"
  }
}
