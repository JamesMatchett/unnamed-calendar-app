{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    // Node only, unlike core, which avoids ambient types because it also runs
    // on Hermes and in a browser. This package runs on Lambda and nowhere else,
    // so process and friends are real here.
    "types": ["node"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*.ts"]
}
